#!/bin/bash

set -o pipefail

#
# Default configuration, overridable on the command line.
#

# RESULT_ROOT:   directory for publishing results
# RESULT_NAME:   subdirectory for publishing results of this test run
# SKIP_WORKTREE: skip preparing worktree, assume it is already done
# E2E_TESTS:     e2e tests to run

# REMOTE_REPO: remote repository to clone
REMOTE_REPO="${REMOTE_REPO:-https://github.com/containers/nri-plugins}"
# CLONED_REPO: local location to clone to
CLONED_REPO="${CLONED_REPO:-/opt/e2e-test/nri-plugins/nri-plugins}"
# TEST_BRANCH: branch to clone and test
TEST_BRANCH="${TEST_BRANCH:-main}"
# RESULT_ROOT: directory for publishing each run's results under
RESULT_ROOT="${RESULT_ROOT:-/opt/e2e-test/nri-plugins/results}"
# RESULT_NAME: name of new test run, minted in UTC because that is how a name is
# read back: retention and e2e-report both take a run's name for UTC, and the
# polling hook mints the one it asks for the same way.
RESULT_NAME="${RESULT_NAME:-$(date -u +%Y-%m-%d-%H-%M)}"
# PROXIES_SRC: bash-sourcable file to set up proxies in the environment
PROXIES_SRC=""
# SKIP_WORKTREE: if set to non-empty, assume worktree already exists
SKIP_WORKTREE="${SKIP_WORKTREE:-}"
# E2E_TESTS: end-to-end tests to run instead of full test set
E2E_TESTS="${E2E_TESTS:-}"
# KEEP_COVERAGE_DATA: keep the collected coverage data, not just the report
KEEP_COVERAGE_DATA="${KEEP_COVERAGE_DATA:-}"
# KEEP_ARTIFACTS: whose bulky artifacts to keep as they are instead of packing
# them up: the tests which failed (the default), all tests, or none of them
KEEP_ARTIFACTS="${KEEP_ARTIFACTS:-failed}"
# PACK_RESULTS: pack up everything a run collected, and keep all of it: a run
# takes a tenth of what it takes browsable, but browsing it takes e2e-report
# serve. Off unless asked for, so that results stay plain files by default.
PACK_RESULTS="${PACK_RESULTS:-}"
# K8SCRI: container runtime to test with, empty to alternate by the day
K8SCRI="${K8SCRI:-}"
# FULL_BUILD: 1 to build all binaries and images, 0 for the minimal set of
# them, empty to build everything once a week and the minimal set otherwise
FULL_BUILD="${FULL_BUILD:-}"
# OWN_TOOLING: run the tests of the branch with the tooling in the tree we were
# started from rather than the branch's own.
OWN_TOOLING="${OWN_TOOLING:-}"

# This script.
SELF="$0"
TEST_SUITE_DIR=policies.test-suite
GIT_SHA1="git.sha1"
GIT_DESC="git.describe"
GIT_REMOTE="git.remote"
# GIT_BRANCH: which branch of the remote was tested
GIT_BRANCH="git.branch"
# GIT_RUNNER: which tree this script itself came from, when we can tell
GIT_RUNNER="git.runner"
# E2E_REPORT: This generates reports of collected results. We build it
# somewhere under /tmp so nuking a worktree won't nuke it, too.
E2E_REPORT="test/e2e/cmd/e2e-report"
# COVERAGE_REPORT_SH: script in test/e2e which reports on collected coverage
COVERAGE_REPORT_SH="report-coverage.sh"
# COVERAGE_REPORT_DIR: where that script puts the report, within a result dir
COVERAGE_REPORT_DIR="coverage-report"
# STATUS_TXT: where e2e-report records the verdict of a run
STATUS_TXT="status.txt"
# ARTIFACTS_TAR: the bulky artifacts of a test case, packed up
ARTIFACTS_TAR="artifacts.tar.xz"
# PACKED_ARTIFACTS: which artifacts of a test case are worth packing. The
# command transcripts and these logs are all but all of what a run publishes.
# The pyexec files are what the last python snippet of a test was, what it
# printed and what it ran on, which is of interest when a test failed.
PACKED_ARTIFACTS="commands
                  nri-resource-policy.output.txt
                  runtime.containerd.log.txt
                  runtime.crio.log.txt
                  pyexec.output.txt
                  pyexec.py
                  pyexec_state.py
                  cache"
# VAGRANT_DIR: vagrant's VM state directory
VAGRANT_DIR=".vagrant"
# VAGRANT_TMP: vagrant-qemu's VM state directory
VAGRANT_TMP="${VAGRANT_HOME:-$HOME/.vagrant.d}/tmp/vagrant-qemu"
# QEMU_PID: the pid file qemu is started with, within VAGRANT_TMP/<id>
QEMU_PID="qemu.pid"
# RUN_LOCK: what we hold for as long as a run lasts, in the result root. Two
# runs sharing a result root would share a worktree and fight over the VMs.
RUN_LOCK=".e2e-runner.lock"
# RUN_LOCK_FD: the environment variable naming the file descriptor the lock is
# held on. Exported for the re-exec, which inherits the descriptor and must not
# lock again: a second flock of the same file from the same process fails, the
# lock being per open file rather than per process.
RUN_LOCK_FD="E2E_RUN_LOCK_FD"


#
# Derived configuration, set up after command line parsing
#
# RESULT_DIR:        directory for publishing results of this test run
# WORKTREE:          git worktree for this test run
# LOG:               log file for this test run
# E2E_REPORT_BIN:    e2e-report, built out of the worktree
# E2E_REPORT_DIR:    where it was built, ours to remove
# VMS_LEFT_RUNNING:  test VMs we failed to destroy, if any
# RE_EXECED:         whether we are the copy the bootstrap re-execed into
# OWN_TREE:          the tree we were started from, for --own-tooling

RESULT_DIR=""
LOG=""
WORKTREE=""
E2E_REPORT_BIN=""
E2E_REPORT_DIR=""
VMS_LEFT_RUNNING=""

# Whether our bootstrap copy re-execed into us, which is what says the lock is
# already held. Read here, before anything of ours sets it, and never from the
# option we were passed: --skip-worktree is for anyone to give.
RE_EXECED=""
if [ -n "${!RUN_LOCK_FD}" ]; then
    RE_EXECED=1
fi

# The tree we were started from, which --own-tooling takes the tooling from:
# three levels up from scripts/testing/nightly, resolved so that being invoked
# through a relative path or a symlink makes no difference.
OWN_TREE="$(realpath -m "$(dirname "$(realpath "$SELF")")/../../..")"

usage() {
    local exit_code="${exit_code:-0}"

    echo "usage: ${1:-$SELF} [options] [<e2e-tests>]"
    echo
    echo "The possible options are:"
    echo "  --source-proxies <file>   source proxy environment variables from file"
    echo "  --remote|r <repo>         remote repository to clone/fetch from"
    echo "  --branch|-b <branch>      name of the remote branch to test"
    echo "  --local|-l <dir>          local directory to clone remote repository into"
    echo "  --results|--out|-o <dir>  top-level directory for publishing results"
    echo "  --name|-n <name>          subdirectory for results of this run"
    echo "  --skip-worktree           skip worktree preparation, assume already done"
    echo "  --keep-coverage-data      keep collected coverage data, not just the report"
    echo "  --keep-artifacts <what>   keep the command transcripts and the logs of"
    echo "                            all|failed|none of the tests as they are, and"
    echo "                            pack up the rest (default: $KEEP_ARTIFACTS)"
    echo "  --pack-results            pack up everything a run collected, and keep"
    echo "                            all of it (needs e2e-report serve to browse)"
    echo "  --no-pack-results         publish the results as plain files"
    echo "  --runtime <runtime>       containerd or crio, by default the two of"
    echo "                            them on alternating days"
    echo "  --own-tooling             test the branch with the tooling in the"
    echo "                            tree we were started from, not the"
    echo "                            branch's: the tests and the plugins are"
    echo "                            the branch's, the runner and e2e-report"
    echo "                            stay ours"
    echo "  --full-build              build all binaries and images"
    echo "  --minimal-build           build the plugins the tests need, no more"
    echo "                            (by default full once a week, minimal otherwise)"
    echo "  --trace|-t|-x             run with set -x"
    echo "  --help                    show this help"

    exit $exit_code
}

info() {
    echo 1>&2 "$@"
}

error() {
    echo 1>&2 "error: $@"
}

fatal() {
    echo 1>&2 "fatal error: $@"
    exit 1
}

must-cd() {
    if ! cd "$1"; then
        fatal "failed to change directory to $1"
    fi
}

must-mkdir() {
    local dir="$1"; shift
    if ! mkdir -p "$dir"; then
        fatal "failed to create ${*:+$* }directory $dir"
    fi
}

must-mv() {
    if ! mv $*; then
        fatal "mv $* failed"
    fi
}

source_proxies() {
    local var

    if [ -z "$PROXIES_SRC" ]; then
        info "no proxies to set up..."
        return 0
    fi

    info "setting up proxies..."
    if ! source "$PROXIES_SRC"; then
        fatal "failed to source proxies from $src"
    fi

    for var in http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY; do
        if [ -n "${!var}" ]; then
            info "exporting proxy environment variable $var (with value ${!var})..."
            export $var
        fi
    done
}

acquire_run_lock() {
    # Usage: acquire_run_lock
    #
    # Take the lock which says a run is going, for as long as this one lasts.
    # Two runs sharing a result root would share a worktree, fight over the
    # test VMs and publish over each other.
    #
    # Held on a file descriptor rather than in a pid file, so the kernel drops
    # it when we go, however we go: there is no such thing as a stale lock here,
    # and nothing to decide about a pid which may have been given to something
    # else since.
    local fd

    if [ -n "$RE_EXECED" ]; then
        return 0
    fi

    if ! command -v flock >/dev/null 2>&1; then
        error "no flock, running without the lock which keeps runs apart..."
        return 0
    fi

    must-mkdir "$RESULT_ROOT" "result root"

    if ! exec {fd}>"$RESULT_ROOT/$RUN_LOCK"; then
        fatal "failed to open the run lock $RESULT_ROOT/$RUN_LOCK"
    fi

    if ! flock -n "$fd"; then
        fatal "another run is going, holding $RESULT_ROOT/$RUN_LOCK"
    fi

    # The descriptor comes with us across the re-exec, which is why the copy we
    # exec into must not lock again: flock is per open file, so a second open of
    # the same lock by the same process would simply fail.
    export $RUN_LOCK_FD="$fd"
}

prepare_worktree() {
    local worktree_dir="$(dirname $CLONED_REPO)/worktree"

    # Resolve with -m. Otherwise WORKTREE would be empty on a
    # host which had never run a test before. That in turn
    # would result in a "git worktree add ''" which in turn
    # would crash with an internal error instead of telling
    # us what went wrong.
    WORKTREE="$(realpath -m "$worktree_dir/$RESULT_NAME")"
    if [ -z "$WORKTREE" ]; then
        fatal "failed to resolve the worktree of $RESULT_NAME under $worktree_dir"
    fi

    case "$SKIP_WORKTREE" in
        1|true|yes|y)
            must-cd "$WORKTREE"
            return 0
            ;;
    esac

    must-mkdir "$worktree_dir" "worktree"

    if [ ! -e "$CLONED_REPO" ]; then
        if ! git clone "$REMOTE_REPO" "$CLONED_REPO"; then
            fatal "failed to clone $REMOTE_REPO to $CLONED_REPO"
        fi
        must-cd "$CLONED_REPO"
    else
        must-cd "$CLONED_REPO"
        if ! git remote -v | grep origin | grep -q "$REMOTE_REPO"; then
            fatal "existing clone $CLONED_REPO has other origin than $REMOTE_REPO"
        fi
        if ! git fetch origin; then
            fatal "failed to fetch $REMOTE_REPO"
        fi
    fi

    info "setting up git worktree $WORKTREE..."
    if ! git worktree add "$WORKTREE" "origin/$TEST_BRANCH"; then
        fatal "failed to add git worktree $WORKTREE"
    fi

    # Asked to be the runner of this run ourselves, so there is nothing to hand
    # over to: the worktree is there to supply the tests and the plugins only.
    if [ -n "$OWN_TOOLING" ]; then
        info "testing $TEST_BRANCH with our own tooling..."
        must-cd "$WORKTREE"
        return 0
    fi

    if [ -x "$WORKTREE/scripts/testing/nightly/e2e-runner" ]; then
        # The options below are passed on, the rest default from the
        # environment, so export those to keep them across the re-exec.
        export KEEP_COVERAGE_DATA KEEP_ARTIFACTS
        export K8SCRI FULL_BUILD PACK_RESULTS KEEP_GIVEN
        exec "$WORKTREE/scripts/testing/nightly/e2e-runner" \
             --skip-worktree \
             ${PROXIES_SRC:+--source-proxies }${PROXIES_SRC:-} \
             --remote "$REMOTE_REPO" \
             --branch "$TEST_BRANCH" \
             --local "$CLONED_REPO" \
             --results "$RESULT_ROOT" \
             --name "$RESULT_NAME" \
             "$E2E_TESTS"
    else
        must-cd "$WORKTREE"
    fi
}

prepare_result_dir() {
    # .txt, so that a browser shows the log instead of downloading it.
    local dir="$RESULT_DIR"
    local log="$dir/${SELF##*/}.log.txt"

    info "creating result dir $dir..."
    must-mkdir "$dir" "result"

    if ! touch "$log"; then
        fatal "failed to create log file $log"
    fi
    LOG="$log"

    # Say that we are at it, until we know how it went. This is what tells a
    # run which is still going from one which never got to the end.
    if ! echo "RUNNING" > "$dir/$STATUS_TXT"; then
        error "failed to write $dir/$STATUS_TXT"
    fi

    # Log to the file, and to the terminal as well when we have one: a run
    # started by hand is worth watching. Started from cron there is no
    # terminal, and printing anything would have the whole log mailed to
    # whoever gets our output.
    if [ -t 1 ]; then
        info "Logging to $LOG and here..."
        if ! exec > >(tee "$LOG") 2>&1; then
            fatal "failed to log to $LOG"
        fi
    else
        info "Redirecting output to log file $LOG..."
        if ! exec &>"$LOG"; then
            fatal "log redirection failed"
        fi
    fi
}

run_e2e_tests() {
    local k8scri="$K8SCRI" full="$FULL_BUILD"

    # Unless we were told which runtime to test with, test every other day
    # with cri-o.
    if [ -z "$k8scri" ]; then
        k8scri=containerd
        if [ $(( $(date +%j) % 2 )) != 0 ]; then
            k8scri=crio
        fi
    fi

    # Unless we were told either way, build all binaries and images once per
    # week, and just the bare minimal set otherwise.
    if [ -z "$full" ]; then
        full=0
        if [ $(( $(date +%j) % 7 )) = 0 ]; then
            full=1
        fi
    fi

    if [ "$full" != "1" ]; then
        info "building the plugins the tests need, no more..."
        export PLUGINS="nri-resource-policy-balloons nri-resource-policy-topology-aware"
        export BINARIES=""
        export OTHER_IMAGE_TARGETS=""
    else
        info "building all binaries and images..."
    fi

    info "running e2e tests ${E2E_TESTS:-with the default test set} on $k8scri..."
    must-cd "$WORKTREE"
    if [ -n "$E2E_TESTS" ]; then
        make SKIP_LICENSES=1 k8scri=$k8scri E2E_TESTS="$E2E_TESTS" e2e-tests
    else
        make SKIP_LICENSES=1 k8scri=$k8scri e2e-tests
    fi
}

vm_machine_id() {
    local dir="$1" id

    # The id vagrant gave the VM, which is what its runtime state is keyed by.
    # One VM per vagrant directory, so the first id we find is the one.
    for id in "$dir/$VAGRANT_DIR"/machines/*/*/id; do
        if [ -f "$id" ]; then
            cat "$id"
            return 0
        fi
    done

    return 1
}

vm_qemu_pid() {
    local pidfile="$1" pid

    if ! read -r pid 2>/dev/null < "$pidfile"; then
        return 1
    fi

    # A pid file which was half written, or emptied by a qemu shutting down as
    # we read it, must not turn into a "kill 0" further down: that signals
    # every process in our own process group, this script included.
    case "$pid" in
        ""|*[!0-9]*)
            return 1
            ;;
    esac
    if [ "$pid" -lt 2 ]; then
        return 1
    fi

    echo "$pid"
}

vm_is_qemu_pid() {
    local pid="$1" pidfile="$2" exe

    # Verify pid file is not stale and a pid potentially reused by some
    # other process. Needs to be in use by a qemu with -pidfile argument.
    if [ ! -d "/proc/$pid" ]; then
        return 1
    fi
    if ! grep -qzxF -- "$pidfile" "/proc/$pid/cmdline" 2>/dev/null; then
        return 1
    fi

    # Try to verify the process is qemu by checking its exe symlink.
    # Best effort, failure to read silently skips the check.
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 0
    case "${exe##*/}" in
        qemu-system-*)
            return 0
            ;;
    esac

    return 1
}

kill_test_vm() {
    local name="$1" pid="$2" pidfile="$3" waited

    if ! kill -0 "$pid" 2>/dev/null; then
        info "the qemu process of $name is already gone..."
        return 0
    fi
    if ! vm_is_qemu_pid "$pid" "$pidfile"; then
        error "pid $pid is not $name's qemu process any more, not killing it"
        return 1
    fi

    info "killing the qemu process $pid of $name..."
    if ! kill -9 "$pid" 2>/dev/null; then
        error "failed to kill the qemu process $pid of $name"
        return 1
    fi

    # Not our child, so there is no reaping to wait for: watch the pid go.
    for waited in 1 2 3 4 5; do
        if ! kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        sleep 1
    done

    error "the qemu process $pid of $name survived SIGKILL"

    return 1
}

destroy_test_vm() {
    local dir="$1" name="${1##*/}" id pidfile="" pid=""

    # Resolve the pid while the vagrant directory is still there.
    # vagrant destroy takes that directory with it.
    id=$(vm_machine_id "$dir")
    if [ -n "$id" ]; then
        pidfile="$VAGRANT_TMP/$id/$QEMU_PID"
        pid=$(vm_qemu_pid "$pidfile")
    fi

    # We don't try a graceful shutdown. We first virtual-pull the plug
    # on the VM using vagrant destroy. If that fails for some reason
    # leaving the VM qemu process running, we try to butcher it ourselves.
    info "destroying test VM $name..."
    if (cd "$dir" && vagrant destroy --force --no-tty); then
        if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        error "destroyed test VM $name, but qemu process $pid is still running"
    else
        error "failed to destroy test VM $name"
    fi

    if [ -z "$pid" ]; then
        error "no qemu pid of $name to fall back on, it may still be running"
        return 1
    fi

    kill_test_vm "$name" "$pid" "$pidfile"
}

cleanup_test_vms() {
    local dir vm

    info "cleaning up test VMs..."
    must-cd "$WORKTREE"

    # Destroy all test VMs, collecting ones which fail.
    for dir in e2e-results/*; do
        if [ ! -d "$dir/$VAGRANT_DIR" ]; then
            continue
        fi
        if ! destroy_test_vm "$dir"; then
            VMS_LEFT_RUNNING="$VMS_LEFT_RUNNING ${dir##*/}"
        fi
    done

    if [ -z "$VMS_LEFT_RUNNING" ]; then
        return 0
    fi

    # List VMs we failed to destroy.
    error "test VMs left behind:$VMS_LEFT_RUNNING"
    error "keeping worktree $WORKTREE for them, to be destroyed by hand with:"
    for vm in $VMS_LEFT_RUNNING; do
        error "    (cd $WORKTREE/e2e-results/$vm && vagrant destroy --force)"
    done
    error "and the worktree removed afterwards with:"
    error "    git -C $CLONED_REPO worktree remove --force $WORKTREE"
}

collect_git_info() {
    local describe="$RESULT_DIR/$GIT_DESC"
    local sha1="$RESULT_DIR/$GIT_SHA1"
    local remote="$RESULT_DIR/$GIT_REMOTE"
    local branch="$RESULT_DIR/$GIT_BRANCH"
    local runner="$RESULT_DIR/$GIT_RUNNER"
    local self dir

    info "collecting info about worktree..."
    must-cd "$WORKTREE"
    git describe > "$describe"
    git log -1 --pretty=%H > "$sha1"
    # For linking the results to the revision and the tests they came from.
    git config --get remote.origin.url > "$remote" || echo "$REMOTE_REPO" > "$remote"
    # A revision says what was tested, the branch says where it was picked up
    # from, which is what tells a nightly of main from one of a branch.
    echo "$TEST_BRANCH" > "$branch"

    # And which tree this script came from, when there is one to tell. Normally
    # the worktree above, since we re-exec ourselves out of it, but a run driven
    # by hand or with --skip-worktree can be run by a script from elsewhere.
    # Only a repository which tracks this very file counts: the script may as
    # well be sitting in an unrelated one, whose HEAD says nothing about it.
    self="$(realpath "$SELF" 2>/dev/null)" || return 0
    dir="$(dirname "$self")"
    if git -C "$dir" ls-files --error-unmatch "$self" >/dev/null 2>&1; then
        git -C "$dir" rev-parse HEAD > "$runner" 2>/dev/null || rm -f "$runner"
    fi
}

collect_results() {
    local src dst

    info "collecting test results..."
    must-cd "$WORKTREE"
    # Only the results of a VM are ours to collect. The tests leave other
    # things next to them, the merged coverage report for one, which we
    # regenerate from the collected data anyway.
    for src in e2e-results/*; do
        if [ ! -d "$src/$TEST_SUITE_DIR" ]; then
            info "skipping $src, it has no $TEST_SUITE_DIR..."
            continue
        fi
        dst=$RESULT_DIR/${src#e2e-results/}
        must-mkdir "$dst" "result"
        must-mv "$src/$TEST_SUITE_DIR" "$dst"
    done
}

prune_junk() {
    local dir="$RESULT_DIR"

    info "removing generated junk from the results..."
    # Byte compiled python of the snippets the tests run through pyexec. Half
    # a megabyte of it per run, and of use to nobody.
    find "$dir" -type d -name __pycache__ -prune -exec rm -rf {} +
    find "$dir" -type f -name '*.pyc' -delete
}

generate_coverage_report() {
    local report="$WORKTREE/test/e2e/$COVERAGE_REPORT_SH"
    local outdir="$RESULT_DIR/$COVERAGE_REPORT_DIR"
    local policy dirs suite

    if [ ! -x "$report" ]; then
        info "no $report, skipping the coverage report..."
        return 0
    fi

    must-cd "$WORKTREE"

    info "generating coverage report for $RESULT_DIR..."
    if ! "$report" --output "$outdir" "$RESULT_DIR"; then
        error "failed to generate coverage report for $RESULT_DIR"
    fi

    # One report per policy, over every topology it was tested on, so that the
    # coverage of a plugin can be told from the coverage of everything.
    for policy in $(policies_tested); do
        dirs=""
        for suite in $RESULT_DIR/*/$TEST_SUITE_DIR/$policy; do
            if [ -d "$suite" ]; then
                dirs="$dirs $suite"
            fi
        done
        if [ -z "$dirs" ]; then
            continue
        fi
        info "generating coverage report of the $policy tests..."
        if ! "$report" --output "$outdir/policies/$policy" $dirs; then
            error "failed to generate coverage report of the $policy tests"
        fi
    done
}

policies_tested() {
    local suite

    for suite in $RESULT_DIR/*/$TEST_SUITE_DIR/*; do
        if [ -d "$suite" ]; then
            echo "${suite##*/}"
        fi
    done | sort -u
}

build_e2e_report() {
    local dir tree="$WORKTREE"

    # Reported on by the revision which was tested, so that a report says what
    # that revision knew to say -- unless the tooling of this run is ours, in
    # which case the reporting is ours too. Half of the tooling would be worse
    # than neither: it is the runner which records what the report reads.
    if [ -n "$OWN_TOOLING" ]; then
        tree="$OWN_TREE"
    fi

    if [ ! -d "$tree/$E2E_REPORT" ]; then
        info "no $E2E_REPORT in $tree, leaving the results unreported..."
        return 0
    fi

    if ! dir="$(mktemp -d)"; then
        error "failed to make a directory to build $E2E_REPORT in"
        return 1
    fi
    E2E_REPORT_DIR="$dir"

    info "building $E2E_REPORT out of $tree..."
    must-cd "$tree"
    if ! go build -o "$dir/e2e-report" "./$E2E_REPORT"; then
        error "failed to build $E2E_REPORT"
        return 1
    fi

    E2E_REPORT_BIN="$dir/e2e-report"
}

cleanup_e2e_report() {
    if [ -n "$E2E_REPORT_DIR" ]; then
        rm -rf "$E2E_REPORT_DIR"
    fi
}

generate_report() {
    if [ -z "$E2E_REPORT_BIN" ]; then
        info "no $E2E_REPORT to report with, leaving the results unreported..."
        return 0
    fi

    # Only this run. The index of all of them is built when it is served, so
    # there is nothing to update in the root.
    info "reporting on $RESULT_DIR..."
    if ! "$E2E_REPORT_BIN" run "$RESULT_DIR"; then
        error "failed to report on $RESULT_DIR"
    fi
}

run_status() {
    # Print the verdict of the run, as e2e-report recorded it.
    # Nothing to go by means something went wrong before the tests,
    # which is not a pass.
    local status="$RESULT_DIR/$STATUS_TXT"

    if [ ! -f "$status" ]; then
        echo "ERROR"
        return
    fi

    read -r verdict _ < "$status"
    echo "${verdict:-ERROR}"
}

cleanup_worktree() {
    # If we failed to destroy some VMs we better not nuke those VM's
    # .vagrant directories. Otherwise vagrant would lose track of them.
    # We leave the whole worktree intact in that case, logging the fact
    # and letting the user sort out what to do with them.
    if [ -n "$VMS_LEFT_RUNNING" ]; then
        error "keeping worktree $WORKTREE, VMs left in it:$VMS_LEFT_RUNNING"
        return 0
    fi

    info "cleaning up worktree $WORKTREE..."
    must-cd "$CLONED_REPO"
    if ! git worktree remove --force "$WORKTREE"; then
        fatal "failed to remove worktree $WORKTREE..."
    fi
}

generate_summary() {
    local summary="$RESULT_DIR/summary.txt"
    local suite vm dir f test result

    info "generating summary $summary..."
    rm -f "$summary"
    if ! touch "$summary"; then
        error "failed to create $summary"
        return
    fi

    # Every collected VM, whatever its topology is called. Matching the names
    # of the topologies we happen to have would silently leave the results of
    # a new one out of the summary, and out of the verdict of the whole run.
    for suite in $RESULT_DIR/*/$TEST_SUITE_DIR; do
        if [ ! -d "$suite" ]; then
            continue
        fi
        vm="${suite%/$TEST_SUITE_DIR}"
        echo "${vm##*/}:" >> "$summary"
        for dir in $(find $suite -name 'test[0-9]*-*' -type d); do
            # Serve logs as text, otherwise a browser downloads them instead
            # of showing them.
            for f in $dir/*.output $dir/*.log; do
                if [ -f "$f" ]; then
                    must-mv "$f" "$f.txt"
                fi
            done
            test="${dir##*$TEST_SUITE_DIR/}"
            result="- FAIL"
            if [ -f "$dir/summary.txt" ] && grep -q PASS "$dir/summary.txt"; then
                result="+ PASS"
            fi
            echo "  $result $test"
        done | sort >> "$summary"
    done
}

prune_coverage_data() {
    local profile="$RESULT_DIR/$COVERAGE_REPORT_DIR/coverprofile"

    case "$KEEP_COVERAGE_DATA" in
        1|true|yes)
            info "keeping the coverage data collected for the tests..."
            return 0
            ;;
    esac

    # Without a profile there is nothing to fall back on, so keep the data
    # whatever we were told: it is the only coverage we have of this run.
    if [ ! -f "$profile" ]; then
        info "no coverage profile in $RESULT_DIR, keeping the collected data..."
        return 0
    fi

    info "removing the coverage data collected for the tests..."
    # Keep the report, which includes the data merged over the run, so
    # that everything but the per test numbers can still be regenerated
    # from what we publish. Only ever remove data files, then only prune
    # directories which removing those leaves empty.
    find "$RESULT_DIR" -type f \
         \( -name 'covmeta.*' -o -name 'covcounters.*' \) \
         -not -path "$RESULT_DIR/$COVERAGE_REPORT_DIR/*" -delete
    find "$RESULT_DIR" -type d -name coverage -empty -delete
}

pack_artifacts() {
    local dir packed=0 before after

    case "$KEEP_ARTIFACTS" in
        all)
            info "keeping the artifacts of every test as they are..."
            return 0
            ;;
        failed|none)
            ;;
        *)
            error "unknown KEEP_ARTIFACTS \"$KEEP_ARTIFACTS\", keeping everything"
            return 0
            ;;
    esac

    info "packing the artifacts of the tests..."
    before=$(du -sk "$RESULT_DIR" | cut -f1)

    for dir in $(find "$RESULT_DIR" -name 'test[0-9]*-*' -type d); do
        # The artifacts of a test which failed are the ones somebody is going
        # to read, so leave those alone and browsable.
        if [ "$KEEP_ARTIFACTS" = "failed" ] &&
           ! grep -q "Test verdict: PASS" "$dir/summary.txt" 2>/dev/null; then
            continue
        fi
        if pack_test_artifacts "$dir"; then
            packed=$((packed + 1))
        fi
    done

    after=$(du -sk "$RESULT_DIR" | cut -f1)
    info "packed the artifacts of $packed tests," \
         "$(( (before - after) / 1024 ))M of $(( before / 1024 ))M saved"
}

pack_test_artifacts() {
    local dir="$1" what="" f

    for f in $PACKED_ARTIFACTS; do
        if [ -e "$dir/$f" ]; then
            what="$what $f"
        fi
    done
    if [ -z "$what" ]; then
        return 1
    fi

    if ! tar -cJf "$dir/$ARTIFACTS_TAR" -C "$dir" $what; then
        error "failed to pack the artifacts of $dir"
        rm -f "$dir/$ARTIFACTS_TAR"
        return 1
    fi

    # Only ever remove what we know is in the tarball now.
    ( cd "$dir" && rm -rf $what )

    return 0
}

pack_results() {
    local before after

    case "$PACK_RESULTS" in
        1|true|yes)
            ;;
        *)
            return 0
            ;;
    esac

    if [ -z "$E2E_REPORT_BIN" ]; then
        error "no $E2E_REPORT to pack with, leaving the results unpacked"
        return 0
    fi

    # Everything but the report, the results as json and the verdict, which is
    # what tells how the run went without a server to unpack the archive.
    #
    # This is the last thing a run does, because our own log is packed with the
    # rest and whatever is written to it after that goes nowhere: the file is
    # gone by then. So everything worth reading is in the log by now, down to
    # the verdict. The one thing which is not is what packing itself says, the
    # line below and the sizes the tool reports.
    info "packing up the results in $RESULT_DIR..."
    if ! "$E2E_REPORT_BIN" pack "$RESULT_DIR"; then
        error "failed to pack up the results in $RESULT_DIR"
    fi
}

#
# main script
#

HANDOVER_ARGS=""
# KEEP_GIVEN: which of the keep options were given, so that packing can keep
# everything without overriding what we were asked to keep.
KEEP_GIVEN="${KEEP_GIVEN:-}"

while [  "$#" -gt 0 ] && [ "${1#-}" != "$1" ]; do
    case $1 in
        --source-proxies)
            PROXIES_SRC="$2"
            shift 2
            ;;
        --remote|-r)
            REMOTE_REPO="$2"
            shift 2
            ;;
        --branch|-b)
            TEST_BRANCH="$2"
            shift 2
            ;;
        --local|-l)
            CLONED_REPO="$2"
            shift 2
            ;;
        --results|--out|-o)
            RESULT_ROOT="$2"
            shift 2
            ;;
        --name|-n)
            RESULT_NAME="$2"
            shift 2
            ;;
        --skip-worktree)
            SKIP_WORKTREE=1
            shift
            ;;
        --keep-coverage-data)
            KEEP_COVERAGE_DATA=1
            KEEP_GIVEN="$KEEP_GIVEN coverage"
            shift
            ;;
        --keep-artifacts)
            KEEP_ARTIFACTS="$2"
            KEEP_GIVEN="$KEEP_GIVEN artifacts"
            shift 2
            ;;
        --pack-results)
            PACK_RESULTS=1
            shift
            ;;
        --no-pack-results)
            PACK_RESULTS=""
            shift
            ;;
        --runtime|--k8scri)
            K8SCRI="$2"
            shift 2
            ;;
        --own-tooling)
            OWN_TOOLING=1
            shift
            ;;

        --full-build)
            FULL_BUILD=1
            shift
            ;;
        --minimal-build)
            FULL_BUILD=0
            shift
            ;;

        --trace|-t|-x)
            set -x
            shift
            ;;
        --help|-h)
            usage $0
            ;;

        *)
            fatal "unknown command line option $1"
            ;;
        esac
done

E2E_TESTS="$*"
RESULT_DIR="$RESULT_ROOT/$RESULT_NAME"

case "$K8SCRI" in
    ""|containerd|crio)
        ;;
    *)
        fatal "unknown runtime \"$K8SCRI\", expecting containerd or crio"
        ;;
esac

# Said up front rather than when we get to it: asking for our tooling from a
# tree which has none of it is a mistake worth hearing about before a run, not
# after the tests have been run and there is nothing to report them with.
if [ -n "$OWN_TOOLING" ] && [ ! -d "$OWN_TREE/$E2E_REPORT" ]; then
    fatal "no $E2E_REPORT in $OWN_TREE, so there is no tooling of ours to use"
fi

# Packing keeps everything in one archive, and everything is what makes it
# worth serving: keep the artifacts of every test and the coverage data of each
# as well, unless we were told what to keep with them.
case "$PACK_RESULTS" in
    1|true|yes)
        if [[ ! "$KEEP_GIVEN" =~ artifacts ]]; then
            KEEP_ARTIFACTS=all
        fi
        if [[ ! "$KEEP_GIVEN" =~ coverage ]]; then
            KEEP_COVERAGE_DATA=1
        fi
        ;;
esac

acquire_run_lock
source_proxies
prepare_worktree
prepare_result_dir
collect_git_info
build_e2e_report
generate_report
run_e2e_tests
cleanup_test_vms
collect_results
prune_junk
generate_coverage_report
generate_summary
prune_coverage_data
pack_artifacts
generate_report
cleanup_worktree

# Say a final summary of how the run went. The test verdict
# can be read from status.txt or status.json, not from our
# exit code.
info "verdict of $RESULT_NAME: $(run_status)"

# Delay packing things up as late as possible. It packs (and
# unlinks) the very file we're logging into.
pack_results
cleanup_e2e_report
