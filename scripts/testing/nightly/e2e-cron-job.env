# Configuration for e2e-cron-job, to be installed as
# /etc/sysconfig/nri-plugins-e2e-cron-job, which is where the script looks and the
# only place it is worth putting: nothing then has to name the path, neither a
# crontab line nor somebody at a prompt. E2E_CRON_ENV overrides it where that is
# needed, and then everything invoking the script has to set it.
#
# One file for the whole nightly. e2e-cron-job sources it with set -a, so
# everything here is exported: the orchestrator picks out the settings which are
# its own, and hands its environment to every hook, which pick out theirs. Neither
# has to know the other's names, and there is one file to edit rather than one per
# hook.
#
# Most settings left out here keep a default, so uncomment only what this host
# changes. The few which are not commented out are the ones nothing downstream will
# guess at: E2E_ROOT has nowhere to default to, and the run hook refuses to invent a
# repository, a branch or somewhere to publish rather than test the wrong thing.
#
# Gone, and silently doing nothing if left here from an older host:
# E2E_RUN_IF_CHANGED, which has no successor -- E2E_FORCE_AFTER=0 is now how to
# ask for a test on every trigger -- and E2E_UPDATE_CLONE, e2e-cron-job no longer
# touching the clone at all.


## What the orchestrator reads

# Where the queue, the jobs, the finished jobs and the hooks' own state live. It
# is made as needed, and holds nothing big: a request, a log and a status per job.
# No default, because a wrong guess here is a queue nobody is servicing.
E2E_ROOT=/opt/e2e-test/nri-plugins/orchestrator

# The hook root, one directory per event: tick, pre-run, run and post-run.
# Defaults to the hooks.d beside e2e-cron-job, which is where the shipped hooks
# are, so set this only to run hooks of your own.
#E2E_HOOKS=/opt/e2e-test/nri-plugins/hooks.d

# How many jobs may have a run hook going at once. Ships at 1, which is what the
# runner's own lock already enforced, and raising it needs work first: two
# concurrent runs of one matrix would want the same test VM, and the runner's lock
# would refuse the second anyway. It is a flake knob as much as a throughput one,
# the tests waiting on readiness with timeouts on the very CPUs a second run would
# contend for, so what it may safely be is a measurement on this host.
#E2E_MAX_JOBS=1

# Seconds a hook gets before it is killed. Every event but run, which is unbounded
# because work taking hours is the normal case. A tick holds a lock while its hooks
# run, so this also bounds how long one tick can hold up the next.
#E2E_HOOK_TIMEOUT=300

# How many finished job directories to keep under done/. Nothing to do with the
# published results, which E2E_RETENTION_DAYS below is about.
#E2E_DONE_KEEP=200


## What the hooks read

# The repository to test a branch of, and which branch. Read by the polling hook,
# which asks the remote what the branch is at, and by the run hook, which tests it.
# A request may override either, which is how a one-off tests something else:
#
#   e2e-cron-job request key=manual branch=my-topic trigger=by-hand
#
# Set here rather than left to default, because the polling hook defaults them and
# the run hook refuses to: a request which carries neither, the nightly one being
# the case, has nothing but this file to go on.
E2E_REMOTE=https://github.com/containers/nri-plugins
E2E_BRANCH=main

# Test anyway once this long has passed with nothing new, so that a quiet week
# still gets a run a day. Takes 30m, 12h, 3d or a bare number of hours; never (or
# nothing at all) to leave a quiet branch alone, and 0 to test on every tick. The
# clock runs from the last request the polling hook made, not from the last forced
# one, so a branch which moves daily is never forced at all.
#
# Polling only ever asks for a test of a branch which moved, and this is the one
# exception to that, which is why E2E_RUN_IF_CHANGED has nothing to switch on any
# more: what emptying it used to ask for is 0 here.
#
# This overlaps the nightly crontab line, and a host wants one of the two, not both:
# left at the default beside that line, a quiet branch gets the nightly and a forced
# run as well, which is two multi-hour runs a day on a host which does one at a time.
# Set it to never and keep the nightly, or drop the nightly line and leave this be.
# See "The nightly line and E2E_FORCE_AFTER overlap" in README.md.
#E2E_FORCE_AFTER=24h

# Where each run publishes its results. This is what e2e-report serve serves, and
# the runs of one result root are kept apart by a lock in it: two runners pointed
# at the same root would share a worktree and fight over the test VMs.
#
# Set here for the same reason as the two above: the run hook, latest and retention
# all insist on being told, a wrong guess here being a run published where nothing
# serves it and a prune of a directory nobody meant.
E2E_RESULTS=/opt/e2e-test/nri-plugins/results

# Remove published results older than this many days, and never remove this many
# newest ones whatever their age. 0 days, or never, keeps everything. Applied by a
# post-run hook after every job, so a machine which has not tested lately still
# tidies up.
#E2E_RETENTION_DAYS=100
#E2E_RETENTION_KEEP=10

# A file setting up proxies in the environment, if this host needs one to reach
# the remote and pull images. It is sourced, so it is executed: keep it to proxy
# settings, because anything else in it wins over this file.
#E2E_PROXIES=/etc/sysconfig/proxy

# Where to keep the clone. A clone belongs to one remote -- the runner refuses one
# whose origin is another -- so testing a fork wants its own directory here, and
# the URL has to be spelled the same way every time (an https clone is not an ssh
# one as far as that check is concerned).
#E2E_CLONE=/opt/e2e-test/nri-plugins/nri-plugins

# Publish a run as a single archive, keeping everything it collected: a tenth of
# what it takes as plain files, and nothing thrown away. Browsing it needs
# e2e-report serve, so set this to nothing if a file server is all there is.
#
# Set here because nothing defaults it any more. e2e-cron-job used to, and a host
# which comments this out now gets plain files, which is the runner's own default.
E2E_PACK_RESULTS=1

# Test the branch with the tooling in the tree e2e-cron-job is installed from,
# rather than the branch's own: the tests and the plugins stay the branch's, the
# runner and e2e-report are ours. This is how to exercise tooling changes against
# a branch which knows nothing about them -- E2E_BRANCH=main with this on tests
# main's plugins and main's tests with your runner.
#E2E_OWN_TOOLING=1

# Anything else to pass the runner, as it would be on its command line, and the
# tests to run instead of the whole set. Several words in one value are fine, and
# both are split on whitespace.
#E2E_OPTIONS=--runtime crio --keep-coverage-data
#E2E_TESTS=test/e2e/policies.test-suite/topology-aware
