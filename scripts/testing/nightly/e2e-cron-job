#
# Run the orchestrator from cron.
#
# A thin front and nothing else: the settings file, the proxies, and then whatever
# arguments we were given, handed to e2e-orchestrator. So one crontab line ticks
# and another submits a request:
#
#   PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
#   */5 * * * * /path/to/scripts/testing/nightly/e2e-cron-job tick
#   2 2 * * *   /path/to/scripts/testing/nightly/e2e-cron-job request key=nightly
#
# Ticking every five minutes is not a typo, and nothing here decides whether to
# test: a tick runs the tick hooks, and hooks.d/tick/10-poll-branch asks the
# remote whether the branch has moved since it last looked. That is how a merged
# PR gets tested soon after it lands rather than the following night. What keeps
# one run at a time is the cap, E2E_MAX_JOBS, which ships at 1.
#
# Settings come from one file, installed and edited:
#
#   install -m 644 scripts/testing/nightly/e2e-cron-job.env \
#       /etc/sysconfig/nri-plugins-e2e-cron-job
#
# That path and no other, so that neither a crontab line nor somebody at a prompt
# has to name it. E2E_CRON_ENV overrides it, for a host which cannot write there or
# which runs two of these, and then everything invoking us has to set it.
#
# Nothing here insists on the file, but a host wants one: the orchestrator has no
# default for E2E_ROOT, and the run hook would rather fail than invent a repository
# to test or somewhere to publish it.

set -o pipefail

SELF="$(basename "$0")"
HERE="$(dirname "$(realpath "$0")")"

# A crontab line from before the orchestrator carries no arguments at all, and
# would otherwise get the orchestrator's usage with nothing to say why. Said here
# because a host mid-migration is exactly where this happens.
if [ $# -eq 0 ]; then
    echo "$SELF: nothing to do: say 'tick', or 'request key=value ...'" >&2
    exit 2
fi

# ENV_FILE: where a host says what it wants, and the only thing to edit
ENV_FILE="${E2E_CRON_ENV:-/etc/sysconfig/nri-plugins-e2e-cron-job}"

# set -a so that what the file sets is exported and not merely read, which is the
# whole of how a hook gets configured.
#
# The orchestrator picks out the settings which are its own, and hands its
# environment to every hook, which pick out theirs: so E2E_REMOTE, E2E_RESULTS,
# E2E_RETENTION_DAYS and the rest arrive at the hook that wants them without
# anything in between having to know their names. Sourced without set -a they
# would be variables of this shell and reach nobody, and that was measured rather
# than reasoned about: a tick whose E2E_REMOTE was not exported polls the default
# remote and asks for a test of upstream main.
if [ -r "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    if ! source "$ENV_FILE"; then
        echo "$SELF: failed to read $ENV_FILE" >&2
        exit 1
    fi
    set +a
fi

# Kept before the proxies file is sourced below, and after the settings file above,
# which is the one place entitled to set it. The proxies file is executed rather than
# parsed, so it can assign anything, this included, and this variable is the whole of
# what this script goes on to exec. Compared afterwards rather than simply used, so
# that an assignment which was not meant is said out loud instead of ignored.
orchestrator_given="$E2E_ORCHESTRATOR"

# The proxies this host needs to reach the remote and pull images. Done here as
# well as in the polling hook, so that everything a tick starts inherits them and
# nothing below has to source the file again. Exported the same way, so a file
# which assigns http_proxy without exporting it works too.
#
# The file is executed, not parsed, so keep it to proxy settings: a stray
# E2E_REMOTE in it would win over the settings file above, and the only sign
# would be the wrong repository being polled.
if [ -n "$E2E_PROXIES" ] && [ -r "$E2E_PROXIES" ]; then
    set -a
    # shellcheck disable=SC1090
    source "$E2E_PROXIES" || true
    set +a
fi

# Not a security guard, and it must not be read as one or built on: the proxies file is
# sourced, which is to say executed, so whoever can write it already runs as this user
# and can do anything at all. What this catches is an accident -- a stray assignment, or
# settings pasted into the proxies file rather than the settings file -- and it is worth
# catching because of what the accident looks like from outside.
#
# Which is also why the test is the value being the one we were given, and not merely
# the value being runnable: /bin/true passes the check below, and something like
# /bin/true is the shape this goes wrong in rather than a contrived one. Point the exec
# at anything which exits zero and every tick succeeds having polled nothing, swept
# nothing and admitted nothing. A nightly doing nothing, saying nothing, for good, which
# is the failure this whole arrangement exists to make impossible.
if [ "$E2E_ORCHESTRATOR" != "$orchestrator_given" ]; then
    echo "$SELF: $E2E_PROXIES set E2E_ORCHESTRATOR to \"$E2E_ORCHESTRATOR\":" \
         "keep that file to proxy settings" >&2
    exit 1
fi

ORCHESTRATOR="${E2E_ORCHESTRATOR:-$HERE/../../../build/bin/e2e-orchestrator}"

if [ ! -x "$ORCHESTRATOR" ]; then
    echo "$SELF: no e2e-orchestrator to run at $ORCHESTRATOR:" \
         "run 'make e2e-orchestrator', or set E2E_ORCHESTRATOR" >&2
    exit 1
fi

# The hooks ship beside us, so that is where they are unless this host says
# otherwise. Left to itself the orchestrator would look under $E2E_ROOT/hooks.d,
# which nothing installs anything into.
export E2E_HOOKS="${E2E_HOOKS:-$HERE/hooks.d}"

# One file for the whole nightly: what we just read is what the orchestrator
# reads. Its own settings are in the environment already, set -a having exported
# them, and the environment wins over the file -- so this is here to name the file
# for every orchestrator downstream of us as well, the one a hook invokes through
# E2E_ORCHESTRATOR included, and there is one answer to which file this host is
# configured by whichever process is asked.
export E2E_ORCHESTRATOR_ENV="${E2E_ORCHESTRATOR_ENV:-$ENV_FILE}"

exec "$ORCHESTRATOR" "$@"
